# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ISO 3166-1 country used for "where to watch" until a user picks their own region.
DEFAULT_REGION=IN

# ── TMDB (https://www.themoviedb.org/settings/api) ────────────────────
TMDB_API_KEY=
# "API Read Access Token" (v4 bearer); used for all v3 calls when present.
TMDB_READ_TOKEN=

# ── OMDb (https://www.omdbapi.com/apikey.aspx) — free tier: 1,000 calls/day ──
OMDB_API_KEY=

# ── YouTube Data API v3 (Google Cloud console → APIs & Services) ──────
# Default quota is 10,000 units/day; one title costs ~101 units.
YOUTUBE_API_KEY=

# ── Gemini (https://aistudio.google.com/apikey) ───────────────────────
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Cheaper, faster model for bulk enrichment (seeding vibe summaries).
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Tried in order when a model is overloaded, rate-limited or slow (comma-separated).
GEMINI_TEXT_FALLBACKS=gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_FAST_FALLBACKS=gemini-flash-lite-latest,gemini-3-flash-preview
GEMINI_EMBED_MODEL=gemini-embedding-2
# Must match numDimensions in the Atlas vector index.
GEMINI_EMBED_DIM=768

# ── Fallback chain (optional): Gemini → Groq → OpenRouter ─────────────
# When Gemini fails, or is still thinking after a few seconds, the same prompt goes to these
# models in order and the first valid answer wins. Embeddings stay on Gemini. Leave a key
# empty to skip that provider.
# Groq (https://console.groq.com/keys): ~1 s answers; free tier ≈ 1,000 requests/day and 8k tokens/min per model.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# OpenRouter (https://openrouter.ai/settings/keys): free models, 3–12 s answers.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# ── MongoDB Atlas ─────────────────────────────────────────────────────
MONGODB_URI=

# ── Firebase Admin (service account JSON → these three fields) ────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences exactly as in the JSON file.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Firebase web app (Project settings → Your apps → Web) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Accounts and Taste Twins ───────────────────────────────────────────
# Shown on /blocked (the appeal link) and /privacy. Optional, but set it before inviting people.
SUPPORT_EMAIL=
# Signs the anonymous Taste Twin tokens. Optional: falls back to the Firebase admin key.
# Any long random string, e.g. `openssl rand -base64 48`.
TWIN_TOKEN_SECRET=
