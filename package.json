{
  "name": "reverie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "tsx scripts/shots.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:env": "tsx --conditions=react-server scripts/check-env.ts",
    "e2e": "playwright test",
    "db:indexes": "tsx --conditions=react-server scripts/db-indexes.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "neighbors": "tsx --conditions=react-server scripts/neighbors.ts",
    "eval:match": "tsx --conditions=react-server scripts/eval-match.ts",
    "migrate:v2": "tsx --conditions=react-server scripts/migrate-v2.ts",
    "backfill:snapshots": "tsx --conditions=react-server scripts/backfill-snapshots.ts",
    "backfill:twins": "tsx --conditions=react-server scripts/backfill-twins.ts",
    "eval:twins": "tsx --conditions=react-server scripts/eval-twins.ts",
    "make-admin": "tsx --conditions=react-server scripts/make-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "mongoose": "^9.11.4",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "node-vibrant": "^4.0.4",
    "p-limit": "^7.3.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
